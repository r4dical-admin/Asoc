FROM node:22-alpine AS frontend

WORKDIR /src/frontend

COPY pocketbase-v1/frontend/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY pocketbase-v1/frontend/ ./

ARG VITE_POCKETBASE_URL=
ENV VITE_POCKETBASE_URL=$VITE_POCKETBASE_URL
RUN npm run build

FROM alpine:3.21

ARG PB_VERSION=0.36.6
ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl unzip \
  && case "${TARGETARCH}" in \
    amd64) pb_arch="amd64" ;; \
    arm64) pb_arch="arm64" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
  esac \
  && curl -fsSL \
    "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${pb_arch}.zip" \
    -o /tmp/pocketbase.zip \
  && unzip /tmp/pocketbase.zip -d /usr/local/bin \
  && chmod +x /usr/local/bin/pocketbase \
  && rm -f /tmp/pocketbase.zip

WORKDIR /pb

COPY --from=frontend /src/frontend/dist /pb/pb_public
COPY pocketbase-v1/pb_migrations /pb/pb_migrations
COPY demo-data /pb/seed-data
COPY pocketbase-v1/pb_hooks /pb/pb_hooks

VOLUME ["/pb/pb_data"]
EXPOSE 8090

CMD ["pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data", "--publicDir=/pb/pb_public", "--migrationsDir=/pb/pb_migrations"]
