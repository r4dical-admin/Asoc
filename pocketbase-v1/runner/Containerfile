FROM node:22-alpine

WORKDIR /runner

COPY pocketbase-v1/runner/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY pocketbase-v1/runner/src ./src

ENV POCKETBASE_URL=http://pocketbase:8090
ENV RUNNER_NAME=runner-compose
ENV RUNNER_POLL_MS=1500
ENV RUNNER_HEARTBEAT_MS=5000

CMD ["npm", "start"]
