POCKETBASE_URL=http://127.0.0.1:8090
RUNNER_NAME=runner-local
RUNNER_POLL_MS=3000
RUNNER_MAX_PARALLEL_TASKS=2
ASOC_RUNNER_EMAIL=runner@asoc.local
# Generate this value and set the same secret on PocketBase and the runner.
# ASOC_RUNNER_PASSWORD=
# RUNNER_ID=

# AI delegate/provider settings.
# Keep real API keys only in an untracked .env file or deployment secret store.
# Use DELEGATE_LAUNCH_MODE=mock for visibly marked fake execution.
DELEGATE_LAUNCH_MODE=ai
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# Provider URLs have working defaults. Override only for a proxy or remote service.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# AI_BASE_URL=  # Generic override, required for openai-compatible.
# AI_REQUEST_TIMEOUT_MS=120000
# GEMINI_API_KEY=
# AI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_API_KEY=  # Optional; local Ollama accepts the placeholder automatically.
INTAKE_PORT=8081
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=
# JIRA_WEBHOOK_SECRET=
